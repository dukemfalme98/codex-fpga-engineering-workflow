{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-contract.schema.json",
  "title": "FPGA task contract",
  "type": "object",
  "required": ["schema_version", "run_id", "snapshot_id", "mode", "authorization", "scope", "non_goals", "immutable_boundaries", "acceptance_evidence"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["ANALYZE", "QUICK", "FULL"]},
    "authorization": {"enum": ["READ_ONLY", "PRODUCT_WRITE", "SEQUENTIAL_WRITES"]},
    "scope": {"type": "array", "items": {"type": "string"}},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "immutable_boundaries": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "acceptance_evidence": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
