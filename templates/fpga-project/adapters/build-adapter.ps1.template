[CmdletBinding()]
param([Parameter(Mandatory)][string]$ProjectRoot, [Parameter(Mandatory)][string]$Action, [Parameter(Mandatory)][string]$JobRoot)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
$vendor = '__VENDOR__'
$extension = '__PROJECT_EXTENSION__'
$local = Import-PowerShellDataFile -LiteralPath (Join-Path $ProjectRoot 'project\script\toolchain.local.psd1')
$settings = Import-PowerShellDataFile -LiteralPath (Join-Path $ProjectRoot 'project\script\setting.psd1')
$projectFiles = @(Get-ChildItem -LiteralPath (Join-Path $ProjectRoot 'project\par') -Recurse -File -Filter "*$extension")
$projectFile = $null
if (-not [string]::IsNullOrWhiteSpace([string]$settings.VendorProjectFile)) {
    $candidate = [IO.Path]::GetFullPath((Join-Path $ProjectRoot ([string]$settings.VendorProjectFile -replace '/', [IO.Path]::DirectorySeparatorChar)))
    if (-not (Test-Path -LiteralPath $candidate -PathType Leaf) -or [IO.Path]::GetExtension($candidate) -ne $extension) { Write-Host '[UNVERIFIED] Configured VendorProjectFile is missing or has the wrong extension.'; exit 3 }
    $projectFile = Get-Item -LiteralPath $candidate
} elseif ($vendor -eq 'PANGO') {
    $preferred = @($projectFiles | Where-Object { $_.Name -eq 'pds_script.pds' })
    if ($preferred.Count -eq 1) { $projectFile = $preferred[0] } elseif ($projectFiles.Count -eq 1) { $projectFile = $projectFiles[0] }
} elseif ($projectFiles.Count -eq 1) { $projectFile = $projectFiles[0] }
if ($null -eq $projectFile) { Write-Host "[UNVERIFIED] Select one authoritative $extension project with VendorProjectFile; found $($projectFiles.Count) candidates."; exit 3 }
$arguments = @($local.BuildArguments | ForEach-Object { ([string]$_).Replace('{projectFile}', $projectFile.FullName).Replace('{projectRoot}', $ProjectRoot).Replace('{action}', $Action).Replace('{jobRoot}', $JobRoot).Replace('{srcList}', (Join-Path $ProjectRoot 'project\script\src_list.txt')).Replace('{ipList}', (Join-Path $ProjectRoot 'project\script\ip_list.txt')).Replace('{includeDirs}', (Join-Path $ProjectRoot 'project\script\include_dirs.txt')).Replace('{defines}', (Join-Path $ProjectRoot 'project\script\defines.txt')) })
[IO.File]::WriteAllText((Join-Path $JobRoot 'command.txt'), (($local.BuildCommand + ' ' + ($arguments -join ' ')) + [Environment]::NewLine), [Text.UTF8Encoding]::new($false))
[IO.File]::WriteAllText((Join-Path $JobRoot 'tool-version.txt'), (([string]$local.ToolVersion) + [Environment]::NewLine), [Text.UTF8Encoding]::new($false))
& $local.BuildCommand @arguments 2>&1 | Tee-Object -FilePath (Join-Path $JobRoot 'run.log')
$code = $LASTEXITCODE
$result = [ordered]@{ status = if ($code -eq 0) {'TOOL_EXIT_PASS'} else {'FAIL'}; evidence_level = if ($code -eq 0) {'COMMAND_COMPLETED_UNVERIFIED'} else {'COMMAND_FAILED'}; vendor = $vendor; action = $Action; exit_code = $code; project_file = $projectFile.FullName }
$result | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath (Join-Path $JobRoot 'result.json') -Encoding utf8NoBOM
Write-Host "[$($result.status)] $vendor build exit code $code. Report-based synthesis/implementation/STA acceptance remains UNVERIFIED."
exit $code
