[CmdletBinding()]
param([Parameter(Mandatory)][string]$ProjectRoot, [Parameter(Mandatory)][string]$Case, [Parameter(Mandatory)][string]$Mode, [Parameter(Mandatory)][int]$Seed, [Parameter(Mandatory)][string]$JobRoot)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
$vendor = '__VENDOR__'
$projectScript = Join-Path $ProjectRoot 'project\script'
$local = Import-PowerShellDataFile -LiteralPath (Join-Path $projectScript 'toolchain.local.psd1')
$settings = Import-PowerShellDataFile -LiteralPath (Join-Path $projectScript 'setting.psd1')
$productSources = Join-Path $ProjectRoot 'simulation\script\product_list.txt'
$testbenchSources = Join-Path $ProjectRoot 'simulation\script\src_list.txt'
$modelList = Join-Path $ProjectRoot 'simulation\script\model_list.txt'
$ipList = Join-Path $ProjectRoot 'simulation\script\ip_list.txt'
$includeDirs = Join-Path $ProjectRoot 'simulation\script\include_dirs.txt'
$defines = Join-Path $ProjectRoot 'simulation\script\defines.txt'
$preparedLibraries = Join-Path $JobRoot 'prepared-libraries.json'
$arguments = @($local.SimulatorArguments | ForEach-Object { ([string]$_).Replace('{projectRoot}', $ProjectRoot).Replace('{productSources}', $productSources).Replace('{testbenchSources}', $testbenchSources).Replace('{modelList}', $modelList).Replace('{ipList}', $ipList).Replace('{includeDirs}', $includeDirs).Replace('{defines}', $defines).Replace('{simulationTop}', [string]$settings.SimulationTop).Replace('{case}', $Case).Replace('{mode}', $Mode).Replace('{seed}', [string]$Seed).Replace('{jobRoot}', $JobRoot).Replace('{preparedLibraries}', $preparedLibraries) })
[IO.File]::WriteAllText((Join-Path $JobRoot 'command.txt'), (($local.SimulatorCommand + ' ' + ($arguments -join ' ')) + [Environment]::NewLine), [Text.UTF8Encoding]::new($false))
[IO.File]::WriteAllText((Join-Path $JobRoot 'tool-version.txt'), (([string]$local.SimulatorVersion) + [Environment]::NewLine), [Text.UTF8Encoding]::new($false))
& $local.SimulatorCommand @arguments 2>&1 | Tee-Object -FilePath (Join-Path $JobRoot 'run.log')
$code = $LASTEXITCODE
$result = [ordered]@{ evidence_profile = 'DIAGNOSTIC_SMOKE'; status = if ($code -eq 0) {'DIAGNOSTIC_ONLY'} else {'FAIL'}; classification = 'INCONCLUSIVE'; vendor = $vendor; case = $Case; mode = $Mode; seed = $Seed; exit_code = $code; note = if ($code -eq 0) {'Compile/elaborate/run command completed. Functional acceptance was not evaluated, so this is not SIMULATION_PASS.'} else {'The generic adapter cannot safely distinguish compile, elaboration, runtime, assertion, model, license, or environment failure from the process exit alone. Inspect run.log and route the failure to its evidence-backed owner.'} }
$result | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath (Join-Path $JobRoot 'result.json') -Encoding utf8NoBOM
Write-Host "[$($result.status)] $vendor simulation exit code $code. Functional acceptance remains UNVERIFIED."
exit $code
